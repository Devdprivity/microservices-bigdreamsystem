# Laravel API Configuration
LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_API_TOKEN=your-api-token-here

# WhatsApp Service
WHATSAPP_SERVICE_PORT=3001
WHATSAPP_SESSION_PATH=./storage/sessions

# AI Service
AI_SERVICE_PORT=3002
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Google Calendar
GOOGLE_CALENDAR_API_KEY=your-google-calendar-key-here
GOOGLE_CALENDAR_ID=your-calendar-id-here

# HTTP Gateway
GATEWAY_PORT=3000

# Moleculer Broker
NODE_ENV=development
LOG_LEVEL=info
